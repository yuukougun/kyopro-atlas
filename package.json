{
  "name": "kyopro-atlas",
  "private": true,
  "description": "表記の検査（textlint）。docs/ の手書きの Markdown を検査する（生成物の docs/lists/・docs/index/・docs/<field>/index.md は除く）",
  "scripts": {
    "lint:text": "textlint \"docs/*.md\" \"docs/!(lists|index)/!(index).md\"",
    "lint:text:fix": "textlint --fix \"docs/*.md\" \"docs/!(lists|index)/!(index).md\""
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-ja-space-around-code": "3.0.4",
    "textlint-rule-ja-space-between-half-and-full-width": "3.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.1"
  }
}
